{
  "type": "object",
  "required": ["mode", "as_of_seq", "proposals"],
  "properties": {
    "mode": {"type": "string", "enum": ["shadow"]},
    "as_of_seq": {"type": "number"},
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "subject_kind", "number", "commit", "evidence", "reason"],
        "properties": {
          "action": {"type": "string", "enum": ["approve", "send_back", "hand_out", "ask_owner", "hold"]},
          "subject_kind": {"type": "string", "enum": ["pull_request", "issue"]},
          "number": {"type": "number"},
          "commit": {"type": "string"},
          "evidence": {
            "type": "object",
            "required": ["file", "line", "text"],
            "properties": {
              "file": {"type": "string"},
              "line": {"type": "number"},
              "text": {"type": "string"}
            }
          },
          "reason": {"type": "string"}
        }
      }
    }
  }
}
