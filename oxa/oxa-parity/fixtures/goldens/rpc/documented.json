{
  "RPC-001": {
    "source": "rpc.md#correlate-commands-and-responses + rpc-commands.md#get_state",
    "response": {
      "type": "response",
      "command": "get_state",
      "success": true,
      "data": {
        "?model": {},
        "thinkingLevel": "",
        "isStreaming": false,
        "isCompacting": false,
        "steeringMode": "",
        "followUpMode": "",
        "sessionFile": null,
        "sessionId": "",
        "?sessionName": "",
        "autoCompactionEnabled": false,
        "messageCount": 0,
        "pendingMessageCount": 0
      }
    }
  },
  "RPC-002": {
    "source": "rpc.md#framing",
    "rule": "one JSON object per LF-terminated record; split only on LF; strip an optional CR before it; no header record (RPC has no session header, json.md)"
  },
  "RPC-003": {
    "source": "rpc.md#run-lifecycle + json.md#event-sequence",
    "rule": "response, then agent_start ... agent_end, then agent_settled; the response is written before the run's events",
    "order": [
      "response",
      "agent_start",
      "agent_end",
      "agent_settled"
    ]
  },
  "RPC-004": {
    "source": "rpc.md#errors + rpc-commands.md#prompt",
    "failed_command": {
      "type": "response",
      "command": "set_model",
      "success": false,
      "error": ""
    },
    "parse_error": {
      "type": "response",
      "command": "parse",
      "success": false,
      "error": "Failed to parse command: "
    },
    "busy": "prompt during a run without streamingBehavior returns an error"
  },
  "RPC-005": {
    "source": "rpc.md#shutdown",
    "rule": "closing stdin requests an orderly shutdown; the process exits after pending work finishes"
  },
  "RPC-006": {
    "source": "rpc-commands.md#prompt",
    "response": {
      "type": "response",
      "command": "prompt",
      "success": true,
      "data": {
        "disposition": "started"
      }
    },
    "rule": "disposition handled = extension command or input handler consumed it; queued = queued during a run; started = accepted to start a run; streamingBehavior steer or followUp queues during a run"
  },
  "RPC-007": {
    "source": "rpc-commands.md#steer",
    "response": {
      "type": "response",
      "command": "steer",
      "success": true,
      "data": {
