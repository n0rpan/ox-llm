# Supply the exact source artifact and its checksum from an inspected workflow run.
pkgname=ox-llm
pkgver=0.2.0
pkgrel=1
pkgdesc='Local AI engine, controller and coding agent (CPU build)'
arch=('x86_64' 'aarch64')
url='https://github.com/n0rpan/ox-llm'
license=('MIT')
depends=('glibc' 'gcc-libs' 'python' 'bubblewrap')
makedepends=('cargo' 'cmake' 'ninja' 'git')
options=('!lto' '!debug' '!strip')
_commit=${OX_SOURCE_COMMIT:?set OX_SOURCE_COMMIT from the workflow artifact}
[[ $_commit =~ ^[0-9a-f]{40}$ ]] || return 1
source=("ox-llm-${_commit}.tar.gz")
sha256sums=("${OX_SOURCE_SHA256:?set OX_SOURCE_SHA256 from verified SHA256SUMS}")

build() {
  cd "$srcdir/ox-llm-$_commit"
  export SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH:?use the source commit timestamp}
  bash packaging/release/build.sh
}

check() {
  cd "$srcdir/ox-llm-$_commit"
  bash packaging/release/check.sh
}

package() {
  cd "$srcdir/ox-llm-$_commit"
  python -B packaging/release/stage.py "$srcdir/payload"
  cp -a "$srcdir/payload/usr" "$pkgdir/"
}
