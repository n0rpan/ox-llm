#!/bin/sh
# Compatibility entry for the Rust-only install; inference is owned by oxa.
case "${1-}" in
  '') exec oxa ;;
  code) shift; exec oxa "$@" ;;
  plan) shift; exec oxa --tools read,grep,find,ls "$@" ;;
  --version|--help|-h) exec oxa "$@" ;;
  panel|share|studio)
    printf '%s\n' 'Panel, LAN share and Studio are disabled in the Rust-only install.' >&2
    exit 2 ;;
  *)
    printf '%s\n' 'This controller command is unavailable in the Rust-only install; run oxa directly.' >&2
    exit 2 ;;
esac
